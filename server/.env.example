# Modèle de server/.env (backend VPS). Copier en server/.env et remplir :
# server/.env n'est pas suivi par Git (secrets), chaque machine garde le sien.
# Chargé au démarrage par server/src/index.ts.

# Base PostgreSQL du backend (documents, comptes)
DATABASE_URL=postgres://njambo:<mot-de-passe>@localhost:5432/njambo
PORT=8081
# HOST=127.0.0.1   (défaut : 127.0.0.1 en production, 0.0.0.0 sinon)

# Compte de service Google (firebase-admin : notifications) : chemin absolu du JSON.
# Le fichier n'est pas suivi par Git ; en production : /opt/njambo-secrets/ (docs/deploiement.md).
GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/service-account.json

# Secret de signature des jetons de connexion : 32 caractères minimum,
# obligatoire en production, différent pour chaque environnement.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Secret HMAC de la grille quotidienne (au moins 32 octets aléatoires)
NJAMBO_GRID_SECRET=

# Fichiers envoyés depuis l'admin (images, sons)
# UPLOAD_DIR=uploads
# PUBLIC_BASE_URL=https://api.votre-domaine   (défaut : déduit de la requête)

# DEV uniquement : saute l'équipement et l'usage unique des cartes de pouvoir.
# Ne jamais mettre à 1 en production.
POWERS_DEV_BYPASS=0

# ── Assistant IA de la console admin (section « Assistant IA ») ──
# Les clés restent sur le serveur, jamais dans le navigateur. Un fournisseur
# sans clé est affiché mais désactivé. AI_<…>_MODEL fixe le modèle proposé
# par défaut (sinon : choix automatique dans la liste lue chez le fournisseur).
DEEPSEEK_API_KEY=
# AI_DEEPSEEK_MODEL=deepseek-v4-pro
ANTHROPIC_API_KEY=
# AI_CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# AI_OPENAI_MODEL=
GEMINI_API_KEY=
# (ou GOOGLE_API_KEY, utilisée si GEMINI_API_KEY est vide)
# AI_GEMINI_MODEL=
# GLM (Z.ai) — plateforme chinoise : GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
# AI_GLM_MODEL=
# MiMo (Xiaomi), clé « sk-… » de paiement à l'usage
MIMO_API_KEY=
# AI_MIMO_MODEL=
# Meta Model API (Muse Spark)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# AI_META_MODEL=
# FreeLLM (service BiSoft, compatible OpenAI)
FREELLM_API_KEY=
FREELLM_BASE_URL=
# AI_FREELLM_MODEL=
# Service compatible OpenAI (Mistral, OpenRouter, Groq, Ollama local…) :
# AI_COMPAT_BASE_URL=http://localhost:11434/v1
# AI_COMPAT_API_KEY=
# AI_COMPAT_MODEL=
# AI_COMPAT_LABEL=Ollama local
# Fournisseur « Simulation » (réponses scriptées, sans clé) : actif hors
# production ; AI_SIMULATION=1 le force, AI_SIMULATION=0 le coupe.
# AI_SIMULATION=0
